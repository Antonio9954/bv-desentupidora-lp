# BV Desentupidora — configuração para Hostinger (Apache/LiteSpeed)
# Todo bloco usa <IfModule> para não quebrar caso o módulo não exista no servidor.

# ---------------------------------------------------------------------------
# Tipo correto para imagens WebP
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# ---------------------------------------------------------------------------
# Página de erro 404
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Não listar o conteúdo de pastas sem index
# ---------------------------------------------------------------------------
Options -Indexes

# ---------------------------------------------------------------------------
# Redirecionamentos: força HTTPS e remove o "www"
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http:// -> https://
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www.dominio -> dominio (sem www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# Cabeçalhos de segurança
# Sem Content-Security-Policy de propósito: bloquearia o Google Tag Manager
# e os pixels (Google Ads / Meta) quando forem instalados.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---------------------------------------------------------------------------
# Compressão (HTML, CSS, JS, SVG, JSON)
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/x-javascript image/svg+xml application/json
  </IfModule>
</IfModule>

# ---------------------------------------------------------------------------
# Cache: imagens e fontes por 1 ano, HTML sem cache (sempre busca a versão nova)
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Bloquear acesso a arquivos ocultos e sensíveis
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteRule ^\.(git|env) - [F,L]
</IfModule>

<FilesMatch "^\.(git|env)">
  Require all denied
</FilesMatch>

<FilesMatch "\.md$">
  Require all denied
</FilesMatch>
